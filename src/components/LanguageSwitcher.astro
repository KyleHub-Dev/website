---
interface Props {
  lang?: 'de' | 'en';
  alternatePath?: string;
}

const { lang = 'de', alternatePath } = Astro.props;
const targetLanguage = lang === 'de' ? 'en' : 'de';
---

{alternatePath && (
  <a
    href={alternatePath}
    class="lang-switch"
    hreflang={targetLanguage}
    lang={targetLanguage}
    aria-label={lang === 'de' ? 'Read this page in English' : 'Diese Seite auf Deutsch lesen'}
  >
    <span class:list={{ 'lang-switch__tag': true, 'lang-switch__tag--active': lang === 'de' }}>DE</span>
    <span class:list={{ 'lang-switch__tag': true, 'lang-switch__tag--active': lang === 'en' }}>EN</span>
  </a>
)}
