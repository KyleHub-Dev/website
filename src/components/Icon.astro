---
type IconName = 'github' | 'codeberg' | 'globe' | 'discord' | 'mail' | 'matrix' | 'mastodon' | 'arrow-up-right' | 'star' | 'fork' | 'issue' | 'pr' | 'lock';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 14, class: className = '', ariaLabel } = Astro.props;
const baseProps = {
  width: size,
  height: size,
  viewBox: '0 0 16 16',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.4,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  class: `icon icon--${name} ${className}`.trim(),
  'aria-hidden': ariaLabel ? 'false' : 'true',
  ...(ariaLabel ? { role: 'img', 'aria-label': ariaLabel } : {}),
};
---

