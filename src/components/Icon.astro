---
import { Icon as AstroIcon } from 'astro-icon/components';

type IconName =
  | 'github'
  | 'globe'
  | 'discord'
  | 'mail'
  | 'arrow-up-right'
  | 'star'
  | 'fork'
  | 'issue'
  | 'pr'
  | 'lock';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const iconMap: Record<IconName, string> = {
  github: 'simple-icons:github',
  discord: 'simple-icons:discord',
  globe: 'lucide:globe',
  mail: 'lucide:mail',
  'arrow-up-right': 'lucide:arrow-up-right',
  star: 'lucide:star',
  fork: 'lucide:git-fork',
  issue: 'lucide:circle-dot',
  pr: 'lucide:git-pull-request',
  lock: 'lucide:lock',
};

const { name, size = 14, class: className = '', ariaLabel } = Astro.props;
const iconName = iconMap[name];
---

<AstroIcon
  name={iconName}
  size={size}
  class={`icon icon--${name} ${className}`.trim()}
  aria-hidden={ariaLabel ? 'false' : 'true'}
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
/>
