---
import { execSync } from 'node:child_process';
import { siteConfig } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const t = lang === 'de'
  ? {
      tagline: 'Öffentliche Dienste und ausgewählte Projekte.',
      code: 'Code',
      legal: 'Rechtliches',
      contact: 'Kontakt',
      githubOrg: 'GitHub Organisation',
      githubPersonal: 'GitHub persönlich',
      impressum: 'Impressum',
      privacy: 'Datenschutz',
      terms: 'AGB',
      discordLabel: 'Discord',
      lastEdited: 'zuletzt bearbeitet',
      build: 'build',
    }
  : {
      tagline: 'Public services and selected projects.',
      code: 'Code',
      legal: 'Legal',
      contact: 'Contact',
      githubOrg: 'GitHub organization',
      githubPersonal: 'GitHub personal',
      impressum: 'Impressum',
      privacy: 'Privacy policy',
      terms: 'Terms',
      discordLabel: 'Discord',
      lastEdited: 'last edited',
      build: 'build',
    };

let lastEdited = process.env.SOURCE_DATE || '';
let buildSha = process.env.SOURCE_REVISION || '';
try {
  buildSha ||= execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] })
    .toString()
    .trim();
  const lastCommitDate = execSync('git log -1 --format=%cs', { stdio: ['ignore', 'pipe', 'ignore'] })
    .toString()
    .trim();
  lastEdited ||= lastCommitDate;
} catch {
  // Source metadata is optional when building without a Git checkout.
}

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__lead">
      <span class="site-footer__shield">
        <img src="/logo.svg" alt="" width="28" height="28" />
        <span class="site-footer__shield-name">KyleHub</span>
      </span>
      <p>{t.tagline}</p>
    </div>

    <div>
      <p class="site-footer__heading">{t.contact}</p>
      <ul class="site-footer__list">
        <li>
          <a href={siteConfig.contact.discord} target="_blank" rel="noopener noreferrer">
            <Icon name="discord" size={14} />
            <span>{t.discordLabel}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${siteConfig.contact.email}`}>
            <Icon name="mail" size={14} />
            <span>{siteConfig.contact.email}</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="site-footer__heading">{t.code}</p>
      <ul class="site-footer__list">
        <li>
          <a href={siteConfig.codeHosts.githubOrg} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={14} />
            <span>{t.githubOrg}</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.codeHosts.githubPersonal} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={14} />
            <span>{t.githubPersonal}</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="site-footer__heading">{t.legal}</p>
      <ul class="site-footer__list">
        <li><a href={lang === 'de' ? '/impressum' : '/en/impressum'}><span>{t.impressum}</span></a></li>
        <li><a href={lang === 'de' ? '/datenschutz' : '/en/privacy-policy'}><span>{t.privacy}</span></a></li>
        <li><a href={lang === 'de' ? '/agb' : '/en/terms'}><span>{t.terms}</span></a></li>
      </ul>
    </div>
  </div>

  <div class="site-footer__meta">
    <span>© {year} KyleHub</span>
    {(lastEdited || buildSha) && <span class="site-footer__meta-build">
      {lastEdited && <span>{t.lastEdited} {lastEdited}</span>}
      {lastEdited && buildSha && ' · '}
      {buildSha && <span>{t.build} <code>{buildSha}</code></span>}
    </span>}
  </div>
</footer>
