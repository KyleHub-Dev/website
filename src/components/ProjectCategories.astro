---
import Icon from './Icon.astro';
import type { ProjectCategory } from '../data/site';

interface Props {
  lang?: 'de' | 'en';
  categories: ProjectCategory[];
}

const { lang = 'de', categories } = Astro.props;
---

<div class="projects-list">
  {categories.map((category) => (
    <section class="project-category" aria-labelledby={`cat-${category.slug}`}>
      <header class="project-category__header">
        <h3 id={`cat-${category.slug}`} class="project-category__title">{category.title[lang]}</h3>
      </header>
      <ul class="project-category__list">
        {category.projects.map((project) => (
          <li class="repo-row">
            <a class="repo-row__link" href={`https://github.com/${project.owner}/${project.repo}`}>
              <span class="repo-row__name">{project.name}</span>
              <p class="repo-row__desc">{project.description[lang]}</p>
              <span class="repo-row__destination">
                <Icon name="github" size={14} />
                {project.owner}/{project.repo}
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
