---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Wordmark from '../components/Wordmark.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'de' | 'en';
  path: string;
  alternatePath?: string;
  nav?: NavLink[];
}

const {
  title,
  description,
  lang = 'de',
  path,
  alternatePath,
  nav = [],
} = Astro.props;

const siteUrl = 'https://kylehub.dev';
const canonical = new URL(path, siteUrl).toString();
const alternate = alternatePath ? new URL(alternatePath, siteUrl).toString() : null;
const homeHref = lang === 'de' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181f1d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" href={alternate} hreflang={lang === 'de' ? 'en' : 'de'} />}
    <link rel="alternate" href={canonical} hreflang={lang} />
    <link rel="alternate" href={canonical} hreflang="x-default" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KyleHub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <Wordmark href={homeHref} ariaLabel="KyleHub home" />
          <nav class="site-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Primary navigation'}>
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={{ 'site-nav__link': true, 'site-nav__link--active': item.href === path }}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <LanguageSwitcher lang={lang} alternatePath={alternatePath} />
        </div>
      </header>
      <main class="page-main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
