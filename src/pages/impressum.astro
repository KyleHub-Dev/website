---
import Layout from '../layouts/Layout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { legalDocs } from '../data/legal';
import { nav } from '../data/site';

const doc = legalDocs['de-impressum'];
---

<Layout
  title="Impressum | KyleHub"
  description="Zentrales Impressum fuer oeffentliche Dienste unter kylehub.dev, porvi.de und deren Subdomains."
  path="/impressum"
  alternatePath="/en/impressum"
  nav={nav.de}
>
  <LegalDocument {...doc} />
</Layout>
