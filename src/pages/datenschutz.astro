---
import Layout from '../layouts/Layout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { legalDocs } from '../data/legal';
import { nav } from '../data/site';

const doc = legalDocs['de-privacy'];
---

<Layout
  title="Datenschutzerklärung | KyleHub"
  description="Zentrale Datenschutzerklärung für öffentliche Dienste unter kylehub.dev und dessen Subdomains."
  path="/datenschutz"
  alternatePath="/en/privacy-policy"
  nav={nav.de}
>
  <LegalDocument {...doc} />
</Layout>
