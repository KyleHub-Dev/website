---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { nav, projectCategories } from '../data/site';

interface RepoStats {
  ok: boolean;
  stars: number;
  forks: number;
  openIssues: number;
  openPRs: number;
  archived: boolean;
  language: string | null;
  pushedAt: string | null;
}

const ghToken = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;

const ghHeaders = {
  'User-Agent': 'kylehub.dev-static-build',
  Accept: 'application/vnd.github+json',
  ...(ghToken ? { Authorization: `Bearer ${ghToken}` } : {}),
};

// open_issues_count on /repos/{owner}/{repo} includes pull requests.
// Count open PRs separately and subtract for an issue-only number.
const fetchOpenPRs = async (owner: string, repo: string): Promise<number> => {
  const res = await fetch(
    `https://api.github.com/repos/${owner}/${repo}/pulls?state=open&per_page=1`,
    { headers: ghHeaders },
  );
  if (!res.ok) return 0;
  const link = res.headers.get('link') ?? '';
  const lastPage = link.match(/[?&]page=(\d+)>;\s*rel="last"/);
  if (lastPage) return parseInt(lastPage[1], 10);
  const data = await res.json();
  return Array.isArray(data) ? data.length : 0;
};

const fetchStats = async (owner: string, repo: string): Promise<RepoStats> => {
  try {
    const [repoRes, openPRs] = await Promise.all([
      fetch(`https://api.github.com/repos/${owner}/${repo}`, { headers: ghHeaders }),
      fetchOpenPRs(owner, repo),
    ]);
    if (!repoRes.ok) return { ok: false, stars: 0, forks: 0, openIssues: 0, openPRs: 0, archived: false, language: null, pushedAt: null };
    const data = await repoRes.json();
    // GitHub's `open_issues_count` is a misnomer - it counts issues AND open PRs.
    // The only way to get an issue-only number is to subtract the PR count.
    const issuesPlusPRs = data.open_issues_count ?? 0;
    return {
      ok: true,
      stars: data.stargazers_count ?? 0,
      forks: data.forks_count ?? 0,
      openIssues: Math.max(0, issuesPlusPRs - openPRs),
      openPRs,
      archived: !!data.archived,
      language: data.language ?? null,
      pushedAt: data.pushed_at ?? null,
    };
  } catch {
    return { ok: false, stars: 0, forks: 0, openIssues: 0, openPRs: 0, archived: false, language: null, pushedAt: null };
  }
};

const allRepos = projectCategories.flatMap((c) => c.projects).filter((p) => !p.noStats);
const statsList = await Promise.all(allRepos.map((p) => fetchStats(p.owner, p.repo)));
const statsByRepo = new Map<string, RepoStats>();
allRepos.forEach((p, i) => statsByRepo.set(`${p.owner}/${p.repo}`, statsList[i]));

const fmtRelativeDe = (iso: string | null) => {
  if (!iso) return null;
  const days = Math.round((Date.now() - new Date(iso).getTime()) / 86400000);
  if (days < 1) return 'heute';
  if (days < 7) return `vor ${days} Tag${days === 1 ? '' : 'en'}`;
  if (days < 30) return `vor ${Math.floor(days / 7)} Woche${days < 14 ? '' : 'n'}`;
  if (days < 365) return `vor ${Math.floor(days / 30)} Monat${days < 60 ? '' : 'en'}`;
  return `vor ${Math.floor(days / 365)} Jahr${days < 730 ? '' : 'en'}`;
};
---

<Layout
  title="KyleHub Projekte"
  description="Eine kuratierte Liste der öffentlichen Repositories von KyleHub und KyleDerZweite, gruppiert nach Themenfeld."
  path="/projects"
  alternatePath="/en/projects"
  nav={nav.de}
>
  <section class="projects-hero" aria-labelledby="projects-title">
    <p class="eyebrow"><span>02</span><span class="eyebrow__sep">/</span><span>Repositorien</span></p>
    <h1 id="projects-title" class="projects-hero__title">
      Was hier <em>läuft</em>, langsam und sichtbar.
    </h1>
    <p class="projects-hero__body">
      Eine kuratierte Liste der öffentlichen Projekte, gruppiert nach Themenfeld. Stars, Forks und offene Issues werden zur Build-Zeit von GitHub geholt; sie aktualisieren sich, wenn die Seite das nächste Mal neu gebaut wird, nicht in Echtzeit.
    </p>
  </section>

  <div class="projects-list">
    {projectCategories.map((category, idx) => (
      <section class="project-category" aria-labelledby={`cat-${category.slug}`}>
        <header class="project-category__header">
          <span class="project-category__index">{String(idx + 1).padStart(2, '0')}</span>
          <h2 id={`cat-${category.slug}`} class="project-category__title">{category.title.de}</h2>
        </header>
        <ul class="project-category__list">
          {category.projects.map((project) => {
            const stats = project.noStats ? undefined : statsByRepo.get(`${project.owner}/${project.repo}`);
            return (
              <li class="repo-row">
                <a class="repo-row__link" href={project.href} target="_blank" rel="noopener noreferrer">
                  <div class="repo-row__head">
                    <span class="repo-row__name"><Icon name="github" size={14} /> {project.name}</span>
                    {project.badge && (
                      <span class="repo-row__chip repo-row__chip--quiet">{project.badge.de}</span>
                    )}
                    {stats && stats.ok && stats.archived && (
                      <span class="repo-row__chip"><Icon name="lock" size={12} /> archiviert</span>
                    )}
                    {stats && !stats.ok && (
                      <span class="repo-row__chip repo-row__chip--quiet">privat oder unveröffentlicht</span>
                    )}
                  </div>
                  <p class="repo-row__desc">{project.text.de}</p>
                  <div class="repo-row__meta">
                    {project.noStats && (
                      <span class="repo-row__stat repo-row__stat--quiet">Organisationsseite, keine Repo-Metadaten.</span>
                    )}
                    {!project.noStats && stats && stats.ok && (
                      <>
                        {stats.language && (
                          <span class="repo-row__lang"><span class="repo-row__lang-dot" data-lang={stats.language}></span>{stats.language}</span>
                        )}
                        <span class="repo-row__stat" title="Stars">
                          <Icon name="star" size={12} /> {stats.stars}
                        </span>
                        <span class="repo-row__stat" title="Forks">
                          <Icon name="fork" size={12} /> {stats.forks}
                        </span>
                        <span class="repo-row__stat" title="Offene Issues">
                          <Icon name="issue" size={12} /> {stats.openIssues}
                        </span>
                        <span class="repo-row__stat" title="Offene Pull Requests">
                          <Icon name="pr" size={12} /> {stats.openPRs}
                        </span>
                        {stats.pushedAt && (
                          <span class="repo-row__stat repo-row__stat--time">
                            {fmtRelativeDe(stats.pushedAt)}
                          </span>
                        )}
                      </>
                    )}
                    {!project.noStats && (!stats || !stats.ok) && (
                      <span class="repo-row__stat repo-row__stat--quiet">Metadaten momentan nicht verfügbar.</span>
                    )}
                  </div>
                  <span class="repo-row__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Layout>
