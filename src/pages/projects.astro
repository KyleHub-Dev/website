---
import Layout from '../layouts/Layout.astro';
import { nav, projects } from '../data/site';
---

<Layout
  title="KyleHub Projekte"
  description="GitHub-Projekte der KyleHub-Organisation."
  path="/projects"
  alternatePath="/en/projects"
  nav={nav.de}
>
  <section class="page-intro">
    <p class="eyebrow">Projekte</p>
    <h1>GitHub-Links.</h1>
    <p>Eine reduzierte Liste der oeffentlichen KyleHub-Repositories.</p>
  </section>

  <section class="section-block">
    <div class="project-list">
      {projects.de.map((project) => (
        <a href={project.href} class="project-row">
          <span>
            <strong>{project.name}</strong>
            <small>{project.text}</small>
          </span>
          <span aria-hidden="true">GitHub</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
