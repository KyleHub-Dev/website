---
import Layout from '../../layouts/Layout.astro';
import { nav, projects } from '../../data/site';
---

<Layout
  title="KyleHub Projects"
  description="GitHub projects of the KyleHub organization."
  lang="en"
  path="/en/projects"
  alternatePath="/projects"
  nav={nav.en}
>
  <section class="page-intro">
    <p class="eyebrow">Projects</p>
    <h1>GitHub links.</h1>
    <p>A reduced list of public KyleHub repositories.</p>
  </section>

  <section class="section-block">
    <div class="project-list">
      {projects.en.map((project) => (
        <a href={project.href} class="project-row">
          <span>
            <strong>{project.name}</strong>
            <small>{project.text}</small>
          </span>
          <span aria-hidden="true">GitHub</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
