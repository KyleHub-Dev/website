---
import Layout from '../../layouts/Layout.astro';
import { homeContent, nav, projectGroups } from '../../data/site';

const content = homeContent.en;
---

<Layout
  title={content.title}
  description={content.description}
  lang="en"
  path="/en/"
  alternatePath="/"
  nav={nav.en}
>
  <section class="hero-panel">
    <div class="hero-panel__copy">
      <p class="eyebrow">{content.heroEyebrow}</p>
      <h1>{content.heroTitle}</h1>
      <p class="hero-panel__lede">{content.heroBody}</p>
      <div class="hero-panel__actions">
        <a href={content.primaryCta.href} class="button button--primary">{content.primaryCta.label}</a>
        <a href={content.secondaryCta.href} class="button button--ghost">{content.secondaryCta.label}</a>
      </div>
    </div>
    <div class="hero-panel__frame">
      <div class="signal-grid">
        <div>
          <p class="signal-grid__label">Umbrella</p>
          <p class="signal-grid__value">kylehub.dev</p>
        </div>
        <div>
          <p class="signal-grid__label">Domains</p>
          <p class="signal-grid__value">kylehub.dev + porvi.de</p>
        </div>
        <div>
          <p class="signal-grid__label">Legal pages</p>
          <p class="signal-grid__value">/impressum + /datenschutz</p>
        </div>
        <div>
          <p class="signal-grid__label">Coverage</p>
          <p class="signal-grid__value">central category model</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lane-grid">
    {content.lanes.map((lane) => (
      <article class="lane-card">
        <p class="eyebrow">{lane.title}</p>
        <p>{lane.text}</p>
      </article>
    ))}
  </section>

  <section class="feature-band">
    <div class="feature-band__copy">
      <p class="eyebrow">{content.spotlightTitle}</p>
      <h2>Infrastructure remains the technical backbone.</h2>
      <p>{content.spotlightBody}</p>
    </div>
    <div class="feature-band__actions">
      {content.spotlightCtas.map((cta) => (
        <a href={cta.href} class="button button--primary">{cta.label}</a>
      ))}
    </div>
  </section>

  <section class="project-shelves">
    {projectGroups.en.map((group) => (
      <div class="project-shelf">
        <div class="project-shelf__intro">
          <p class="eyebrow">{group.title}</p>
          <h2>{group.title}</h2>
        </div>
        <div class="project-card-grid">
          {group.items.map((item) => (
            <a href={item.href} class="project-card">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="closing-note">
    <p class="eyebrow">{content.sections.legal}</p>
    <h2>One central legal system for the public domain families.</h2>
    <p>
      Public services under <code>kylehub.dev</code>, <code>porvi.de</code>, and their subdomains
      link to the central impressum, privacy policy, and terms where relevant. More specific legal
      text is only needed when a service publishes different details.
    </p>
  </section>
</Layout>
