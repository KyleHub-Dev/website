---
import Layout from '../../layouts/Layout.astro';
import { homeContent, nav, projects } from '../../data/site';

const content = homeContent.en;
---

<Layout
  title={content.title}
  description={content.description}
  lang="en"
  path="/en/"
  alternatePath="/"
  nav={nav.en}
>
  <section class="page-intro">
    <p class="eyebrow">{content.heroEyebrow}</p>
    <h1>{content.heroTitle}</h1>
    <p>{content.heroBody}</p>
    <div class="actions">
      <a href={content.primaryCta.href} class="button">{content.primaryCta.label}</a>
      <a href={content.secondaryCta.href} class="button button--secondary">{content.secondaryCta.label}</a>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">{content.sections.projects}</p>
      <h2>GitHub</h2>
    </div>
    <div class="project-list">
      {projects.en.map((project) => (
        <a href={project.href} class="project-row">
          <span>
            <strong>{project.name}</strong>
            <small>{project.text}</small>
          </span>
          <span aria-hidden="true">Open</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
