---
import Layout from '../../layouts/Layout.astro';
import HeroProjectPile from '../../components/HeroProjectPile.astro';
import { homeContent, nav } from '../../data/site';

const content = homeContent.en;
---

<Layout
  title={content.title}
  description={content.description}
  lang="en"
  path="/en/"
  alternatePath="/"
  nav={nav.en}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid">
      <div class="hero__lede">
        <p class="eyebrow">
          <span>01</span><span class="eyebrow__sep">/</span><span>Operator</span>
        </p>
        <h1 id="hero-title" class="hero__title">
          {content.titleLead}<br />
          <em>{content.titleAccent}</em><br />
          {content.titleTail}
        </h1>
        <p class="hero__body">
          KyleHub is the central surface for my public services on <code>kylehub.dev</code> and <code>porvi.de</code>. The legal pages live here, a small set of running projects sits to the right, and there is an open door for odd ideas at the bottom of the page.
        </p>
      </div>

      <div class="hero__pile-wrap">
        <HeroProjectPile lang="en" />
      </div>
    </div>
  </section>

  <a class="handoff" href="/en/projects" aria-label="Jump to projects">
    <span class="handoff__label">
      projects <span class="handoff__label-arrow" aria-hidden="true">↓</span>
    </span>
  </a>
</Layout>
