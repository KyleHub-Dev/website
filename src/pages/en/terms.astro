---
import Layout from '../../layouts/Layout.astro';
import LegalDocument from '../../components/LegalDocument.astro';
import { legalDocs } from '../../data/legal';
import { nav } from '../../data/site';

const doc = legalDocs['en-terms'];
---

<Layout
  title="Terms | KyleHub"
  description="Central terms for public services under kylehub.dev and its subdomains."
  lang="en"
  path="/en/terms"
  alternatePath="/agb"
  nav={nav.en}
>
  <LegalDocument {...doc} />
</Layout>
