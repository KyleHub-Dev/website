---
import Layout from '../layouts/Layout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { legalDocs } from '../data/legal';
import { nav } from '../data/site';

const doc = legalDocs['de-terms'];
---

<Layout
  title="Nutzungsbedingungen | KyleHub"
  description="Zentrale Nutzungsbedingungen für öffentliche Dienste unter kylehub.dev und dessen Subdomains."
  path="/agb"
  alternatePath="/en/terms"
  nav={nav.de}
>
  <LegalDocument {...doc} />
</Layout>
