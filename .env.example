# Copy to .env. Use the endpoint and site credentials from Pangolin.
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=
NEWT_SECRET=

# Optional build-time GitHub token for homepage repository metadata.
# A fine-grained token with public-repository read access needs no additional
# permissions. Rate limits depend on the account and token type.
# Passed to the container build as a secret, not a build argument.
GITHUB_TOKEN=
