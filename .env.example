# =============================================================================
# KyleHub Website - Podman Compose Environment
# Copy this file to .env and fill in your values.
# =============================================================================

# Pangolin / NEWT tunnel endpoint.
# Use the hostname or URL your NEWT agents connect to.
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com

# NEWT credentials created in the Pangolin dashboard for this site.
NEWT_ID=
NEWT_SECRET=

# =============================================================================
# Build-time secrets
# =============================================================================

# Optional GitHub fine-grained token used by /projects to fetch repository
# metadata (stars, forks, open issues, last push, language) at build time.
# Without it, the unauthenticated GitHub API limit is 60 req/hour per IP and
# the build will quickly hit it. With a token the limit is 5000/hour.
#
# Create at: https://github.com/settings/personal-access-tokens
#   - Resource owner: your account
#   - Repository access: "Public repositories (read-only)" is enough
#   - No additional permissions required
#
# The token is read from the build environment via import.meta.env.GITHUB_TOKEN
# during static generation only. It is never bundled into the client output.
GITHUB_TOKEN=
